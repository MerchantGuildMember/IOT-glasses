# Copy this file to server/.env and fill in real values. Never commit .env.

# Dashboard login (choose your own, not these)
DASHBOARD_USER=carer
DASHBOARD_PASSWORD=change-me

# Long random string used to sign login cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Shared secret the Pi sends in the X-Device-Token header.
# Generate the same way and put the same value in pi/.env
DEVICE_TOKEN=

# Which LLM to use: "none" (just show the photo), "local" (LM Studio on your PC)
# or "claude" (Anthropic API)
LLM_BACKEND=none

# --- Claude (Anthropic API) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Local (LM Studio, OpenAI-compatible server) ---
LOCAL_LLM_URL=http://localhost:1234/v1/chat/completions
LOCAL_LLM_MODEL=gemma-3-4b-it
